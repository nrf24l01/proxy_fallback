{
    "name": "PhotoPrism",
    "short_name": "PhotoPrism",
    "description": "AI-Powered Photos App for the Decentralized Web",
    "categories": [
        "photo"
    ],
    "display": "standalone",
    "orientation": "any",
    "theme_color": "#000000",
    "background_color": "#000000",
    "scope": "/",
    "start_url": "/library/",
    "serviceworker": {
        "src": "sw.js",
        "scope": "/",
        "use_cache": true
    },
    "permissions": [
        "geolocation",
        "downloads",
        "storage"
    ],
