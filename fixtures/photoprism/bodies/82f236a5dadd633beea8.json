            "purpose": "maskable"
        },
        {
            "src": "/static/icons/logo/maskable/512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "screenshots": [
        {
            "src": "/static/img/screenshots/wide.jpg",
            "sizes": "1280x900",
            "type": "image/jpeg",
            "form_factor": "wide"
        },
        {
            "src": "/static/img/screenshots/narrow.jpg",
            "sizes": "375x667",
            "type": "image/jpeg",
            "form_factor": "narrow"
        }
    ]
}