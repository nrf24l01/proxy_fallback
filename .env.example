# Copy to .env and adjust. All values below are the defaults.

# Image to run. Set to a locally built tag (e.g. srvimit:local) to skip the registry.
IMAGE=ghcr.io/nrf24l01/proxy_fallback:latest
VERSION=dev

# Which recorded service to imitate and on which port (docker-compose.yml).
SERVICE=grafana
PORT=8080

# Where the snapshots live on the host (mounted read-only at /data/fixtures).
FIXTURES_PATH=./fixtures

# Bind address: keep 127.0.0.1 unless something in front of it needs to reach the container.
BIND_ADDR=127.0.0.1

# Whole-catalog variant (docker-compose.catalog.yml).
BASE_PORT=8000
PORT_RANGE=8000-8030

CONTAINER_NAME=srvimit
